{
  "name": "pi-durable-teams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent Pi teams based on the upstream Durable examples",
  "keywords": ["pi-package"],
  "engines": { "node": ">=24" },
  "pi": { "extensions": ["./src/extension.ts"], "skills": ["./skills"] },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "check": "tsc --noEmit",
    "screen": "node scripts/screen.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "pi-web-access": "0.45.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "pi-agents": "./src/pi-agents.ts"
  }
}
