{
  "name": "pi-durable-teams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent Pi teams based on the upstream Durable examples",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-concurrency=1 test/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json",
    "screen": "node scripts/screen.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "file:vendor/pi/earendil-works-chord-1.4.0.tgz",
    "@earendil-works/pi-durable": "file:vendor/pi/earendil-works-pi-durable-1.4.0.tgz",
    "@earendil-works/pi-mcp": "file:vendor/pi/earendil-works-pi-mcp-1.4.0.tgz",
    "marked": "18.0.11",
    "pi-web-access": "0.45.0",
    "web-push": "3.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "file:vendor/pi/earendil-works-pi-ai-1.4.0.tgz",
    "@earendil-works/pi-coding-agent": "file:vendor/pi/earendil-works-pi-coding-agent-1.4.0.tgz",
    "@earendil-works/pi-tui": "file:vendor/pi/earendil-works-pi-tui-1.4.0.tgz",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "@xterm/headless": "^6.0.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "pi-agents": "./src/pi-agents.ts"
  },
  "overrides": {
    "@earendil-works/chord": "file:vendor/pi/earendil-works-chord-1.4.0.tgz",
    "@earendil-works/pi-durable": "file:vendor/pi/earendil-works-pi-durable-1.4.0.tgz",
    "@earendil-works/pi-mcp": "file:vendor/pi/earendil-works-pi-mcp-1.4.0.tgz",
    "@earendil-works/pi-ai": "file:vendor/pi/earendil-works-pi-ai-1.4.0.tgz",
    "@earendil-works/pi-coding-agent": "file:vendor/pi/earendil-works-pi-coding-agent-1.4.0.tgz",
    "@earendil-works/pi-tui": "file:vendor/pi/earendil-works-pi-tui-1.4.0.tgz",
    "@earendil-works/pi-telemetry": "file:vendor/pi/earendil-works-pi-telemetry-1.4.0.tgz",
    "@earendil-works/pi-codemode": "file:vendor/pi/earendil-works-pi-codemode-1.4.0.tgz",
    "@earendil-works/pi-agent-core": "file:vendor/pi/earendil-works-pi-agent-core-1.4.0.tgz"
  }
}
